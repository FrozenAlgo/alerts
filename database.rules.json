{
  "rules": {
    "devices": {
      "$serial": {
        "status": { ".read": true, ".write": true },
        "ping": { ".read": true, ".write": true },
        "commands": { ".read": true, ".write": true },
        "security_pin": { ".read": false, ".write": false },
        ".read": true
      }
    },
    "users": {
      "$userId": {
        "hardware": { ".read": true, ".write": true }
      }
    }
  }
}
