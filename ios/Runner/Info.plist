	<string>OnAlert needs location access to share your position during emergencies.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>OnAlert uses background location for crash detection and live tracking.</string>
	<key>NSCameraUsageDescription</key>
	<string>OnAlert uses the camera to scan device QR codes for pairing.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
